# ==========================================================
# AI HR Recruitment Assistant - Environment Configuration
# ==========================================================

# Ollama Cloud API Key (Required for Ollama Cloud hosted models)
# Never commit your actual key to version control!
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Ollama Base Host/URL (Default: https://api.ollama.com for Cloud, http://localhost:11434 for local)
OLLAMA_BASE_URL=https://api.ollama.com

# Model to use (e.g., gpt-oss:120b, gpt-oss:20b, nemotron-3-nano:30b)
OLLAMA_MODEL=gpt-oss:120b

# Vector store settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=hr_job_descriptions
RAG_TOP_K=4
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100

# Server settings
HOST=127.0.0.1
PORT=8000
MCP_SERVER_PORT=8001
